{
  "version": 1,
  "providers": {
    "gemini": {
      "enabled": true,
      "api_key_env": "GEMINI_API_KEY",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "text_models": [
        "gemini-3.8-flash",
        "gemini-3.7-flash",
        "gemini-3.6-flash",
        "gemini-3.5-flash"
      ],
      "timeout_seconds": 120
    },
    "agnes": {
      "enabled": true,
      "api_key_env": "AGNES_API_KEY",
      "base_url": "https://apihub.agnes-ai.com/v1",
      "chat_model": "agnes-2.5-flash",
      "image_model": "agnes-image-2.1-flash",
      "video_model": "agnes-video-v2.0",
      "timeout_seconds": 120
    },
    "claude": {
      "enabled": false,
      "api_key_env": "ANTHROPIC_API_KEY",
      "base_url": "https://api.anthropic.com/v1",
      "model": "claude-sonnet-4-5",
      "timeout_seconds": 120
    }
  },
  "tasks": {
    "content_ideas": { "provider": "gemini", "response_type": "text" },
    "final_captions": { "provider": "gemini", "response_type": "text" },
    "image_generation": { "provider": "agnes", "response_type": "image" },
    "video_generation": { "provider": "agnes", "response_type": "video" },
    "research": { "provider": "gemini", "response_type": "text" },
    "translation_de_tr": { "provider": "gemini", "response_type": "text" },
    "weekly_plan": { "provider": "gemini", "response_type": "text" },
    "ride_with_me": { "provider": "gemini", "response_type": "text" },
    "quality_check": { "provider": "gemini", "response_type": "text" }
  }
}
