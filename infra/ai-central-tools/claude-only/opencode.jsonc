{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/anthropic/claude-sonnet-4.5",
  "providers": {
    "openrouter": {
      "name": "Existing OpenRouter (Claude only for this worker)",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openrouter",
      "models": {
        "anthropic/claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5 via OpenRouter"
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "openrouter",
        "effect": "allow"
      },
      {
        "action": "permission",
        "resource": "shell:*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "edit:*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "subagent:*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "webfetch:*",
        "effect": "deny"
      }
    ]
  }
}
